/// Tabla para las medidas del reporte.
table _Medidas

	/// Piezas vendidas al consumidor. Walmart: POS Qty. Amazon: unidades pedidas.
	measure 'Sell out piezas' = SUM ( fSellOut[Piezas] )
		formatString: #,0
		displayFolder: 1. Sell out

	/// Venta al consumidor en MXN, a precio de la cadena. Walmart: POS Sales. Amazon: ganancia por pedidos.
	measure 'Sell out monto' = SUM ( fSellOut[Monto] )
		formatString: "$"#,0
		displayFolder: 1. Sell out

	/// Último día con datos de sell out en el contexto.
	measure 'Último día sell out' = MAX ( fSellOut[Datos_hasta] )
		formatString: dd/mm/yyyy
		displayFolder: 1. Sell out

	/// Piezas de los mismos días del año anterior, hasta el último día con datos de cada cadena. Amazon (mensual): el mes en curso se compara en proporción a los días cubiertos.
	measure 'Sell out piezas año anterior' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    VAR _ultimo = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), REMOVEFILTERS ( Calendario ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			    VAR _aa = CALCULATE ( [Sell out piezas], SAMEPERIODLASTYEAR ( Calendario[Fecha] ), Calendario[Fecha] <= EDATE ( _ultimo, -12 ) )
			    VAR _mesParcial = CALCULATE ( [Sell out piezas], SAMEPERIODLASTYEAR ( Calendario[Fecha] ), Calendario[Fecha] = DATE ( YEAR ( _ultimo ) - 1, MONTH ( _ultimo ), 1 ) )
			    VAR _proporcion = DIVIDE ( DAY ( _ultimo ), DAY ( EOMONTH ( _ultimo, 0 ) ) )
			    RETURN
			        IF (
			            ISBLANK ( _ultimo ), BLANK (),
			            IF ( dimCadena[Cadena] = "Amazon", _aa - _mesParcial * ( 1 - _proporcion ), _aa )
			        )
			)
		formatString: #,0
		displayFolder: 1. Sell out

	/// Monto de los mismos días del año anterior, hasta el último día con datos de cada cadena. Amazon (mensual): el mes en curso se compara en proporción a los días cubiertos.
	measure 'Sell out monto año anterior' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    VAR _ultimo = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), REMOVEFILTERS ( Calendario ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			    VAR _aa = CALCULATE ( [Sell out monto], SAMEPERIODLASTYEAR ( Calendario[Fecha] ), Calendario[Fecha] <= EDATE ( _ultimo, -12 ) )
			    VAR _mesParcial = CALCULATE ( [Sell out monto], SAMEPERIODLASTYEAR ( Calendario[Fecha] ), Calendario[Fecha] = DATE ( YEAR ( _ultimo ) - 1, MONTH ( _ultimo ), 1 ) )
			    VAR _proporcion = DIVIDE ( DAY ( _ultimo ), DAY ( EOMONTH ( _ultimo, 0 ) ) )
			    RETURN
			        IF (
			            ISBLANK ( _ultimo ), BLANK (),
			            IF ( dimCadena[Cadena] = "Amazon", _aa - _mesParcial * ( 1 - _proporcion ), _aa )
			        )
			)
		formatString: "$"#,0
		displayFolder: 1. Sell out

	/// Verdadero si la cadena tiene datos cargados en los mismos días del año anterior (de cualquier producto). Sirve para no comparar una cadena que todavía no tiene historial.
	measure 'Hay historial año anterior' =
			VAR _ultimo = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), REMOVEFILTERS ( Calendario ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			RETURN
			    NOT ISBLANK ( _ultimo )
			        && CALCULATE (
			            COUNTROWS ( fSellOut ),
			            SAMEPERIODLASTYEAR ( Calendario[Fecha] ),
			            Calendario[Fecha] <= EDATE ( _ultimo, -12 ),
			            REMOVEFILTERS ( dimProducto ),
			            REMOVEFILTERS ( dimTienda )
			        ) > 0
		displayFolder: 1. Sell out

	/// Sell out en piezas solo de las cadenas que tienen historial del año anterior. Es la base del crecimiento, para comparar lo mismo contra lo mismo.
	measure 'Sell out piezas comparable' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    IF ( [Hay historial año anterior], [Sell out piezas] )
			)
		formatString: #,0
		displayFolder: 1. Sell out

	/// Sell out en monto solo de las cadenas que tienen historial del año anterior. Es la base del crecimiento, para comparar lo mismo contra lo mismo.
	measure 'Sell out monto comparable' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    IF ( [Hay historial año anterior], [Sell out monto] )
			)
		formatString: "$"#,0
		displayFolder: 1. Sell out

	/// Crecimiento en piezas contra los mismos días del año anterior, solo con las cadenas que tienen historial.
	measure 'Crecimiento sell out piezas' = DIVIDE ( [Sell out piezas comparable] - [Sell out piezas año anterior], [Sell out piezas año anterior] )
		formatString: "▲ "0.0%;"▼ "0.0%;0.0%
		displayFolder: 1. Sell out

	/// Crecimiento en monto contra los mismos días del año anterior, solo con las cadenas que tienen historial.
	measure 'Crecimiento sell out monto' = DIVIDE ( [Sell out monto comparable] - [Sell out monto año anterior], [Sell out monto año anterior] )
		formatString: "▲ "0.0%;"▼ "0.0%;0.0%
		displayFolder: 1. Sell out

	/// Parte del monto de sell out que aporta cada producto, dentro de lo filtrado.
	measure 'Participación sell out monto' = DIVIDE ( [Sell out monto], CALCULATE ( [Sell out monto], ALLSELECTED ( dimProducto ) ) )
		formatString: 0.0%
		displayFolder: 1. Sell out

	/// Tarjeta: crecimiento en monto contra los mismos días del año anterior, con flecha. Si una cadena todavía no tiene historial, dice qué cadenas se compararon. "Sin año anterior" si no hay datos para comparar.
	measure 'Texto vs año anterior monto' =
			VAR _aa = [Sell out monto año anterior]
			VAR _crec = [Crecimiento sell out monto]
			VAR _conVenta = FILTER ( VALUES ( dimCadena[Cadena] ), NOT ISBLANK ( [Sell out monto] ) )
			VAR _sinHistorial = FILTER ( _conVenta, NOT [Hay historial año anterior] )
			VAR _comparadas = CONCATENATEX ( FILTER ( _conVenta, [Hay historial año anterior] ), dimCadena[Cadena], " y " )
			RETURN
			    IF (
			        ISBLANK ( _aa ) || _aa = 0, "Sin año anterior",
			        IF ( _crec >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _crec ), "0.0%" )
			            & IF ( COUNTROWS ( _sinHistorial ) > 0, " (solo " & _comparadas & ")" )
			    )
		displayFolder: 1. Sell out

	/// Tarjeta: crecimiento en piezas contra los mismos días del año anterior, con flecha. Si una cadena todavía no tiene historial, dice qué cadenas se compararon. "Sin año anterior" si no hay datos para comparar.
	measure 'Texto vs año anterior piezas' =
			VAR _aa = [Sell out piezas año anterior]
			VAR _crec = [Crecimiento sell out piezas]
			VAR _conVenta = FILTER ( VALUES ( dimCadena[Cadena] ), NOT ISBLANK ( [Sell out piezas] ) )
			VAR _sinHistorial = FILTER ( _conVenta, NOT [Hay historial año anterior] )
			VAR _comparadas = CONCATENATEX ( FILTER ( _conVenta, [Hay historial año anterior] ), dimCadena[Cadena], " y " )
			RETURN
			    IF (
			        ISBLANK ( _aa ) || _aa = 0, "Sin año anterior",
			        IF ( _crec >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _crec ), "0.0%" )
			            & IF ( COUNTROWS ( _sinHistorial ) > 0, " (solo " & _comparadas & ")" )
			    )
		displayFolder: 1. Sell out

	/// Tiendas de Walmart que vendieron al menos una pieza en el periodo.
	measure 'Tiendas con venta' = CALCULATE ( DISTINCTCOUNT ( fSellOut[Tienda_Nbr] ), fSellOut[Cadena] = "Walmart", fSellOut[Piezas] > 0 ) + 0
		formatString: #,0
		displayFolder: 1. Sell out

	/// Sell out en monto o en piezas, según el selector "Ver gráficos en" de la página Sell out (por omisión, monto).
	measure 'Sell out' = IF ( SELECTEDVALUE ( sMetrica[Metrica], "Monto" ) = "Piezas", [Sell out piezas], [Sell out monto] )
		displayFolder: 1. Sell out

		formatStringDefinition = IF ( SELECTEDVALUE ( sMetrica[Metrica], "Monto" ) = "Piezas", "#,0", "$#,0" )

	/// Sell out del año anterior en monto o en piezas, según el selector "Ver gráficos en".
	measure 'Sell out año anterior' = IF ( SELECTEDVALUE ( sMetrica[Metrica], "Monto" ) = "Piezas", [Sell out piezas año anterior], [Sell out monto año anterior] )
		displayFolder: 1. Sell out

		formatStringDefinition = IF ( SELECTEDVALUE ( sMetrica[Metrica], "Monto" ) = "Piezas", "#,0", "$#,0" )

	/// Piezas vendidas en Walmart en los últimos 28 días con datos.
	measure 'Venta 28 días Walmart' =
			VAR _ultimo = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), REMOVEFILTERS ( Calendario ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ), fSellOut[Cadena] = "Walmart" )
			RETURN
			    CALCULATE ( [Sell out piezas], DATESBETWEEN ( Calendario[Fecha], _ultimo - 27, _ultimo ), fSellOut[Cadena] = "Walmart" )
		formatString: #,0
		displayFolder: 1. Sell out

	/// Piezas disponibles en la última foto de cada cadena (Walmart: en tienda; Amazon: aptas para la venta). La fecha de la foto es la última de la cadena, aunque un producto o una tienda ya no aparezca en ella.
	measure 'Inventario piezas' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    VAR _f = CALCULATE ( MAX ( fInventarioCadena[Fecha] ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			    RETURN
			        CALCULATE ( SUM ( fInventarioCadena[Piezas_disponibles] ), fInventarioCadena[Fecha] = _f )
			)
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Fecha de la foto de inventario más reciente en el contexto.
	measure 'Fecha de inventario' = MAX ( fInventarioCadena[Fecha] )
		formatString: dd/mm/yyyy
		displayFolder: 2. Inventario en cadenas

	/// Tiendas de Walmart con más de 0 piezas en la última foto.
	measure 'Tiendas con inventario' =
			VAR _f = CALCULATE ( MAX ( fInventarioCadena[Fecha] ), dimCadena[Cadena] = "Walmart", REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fInventarioCadena[Tienda_Nbr] ),
			        dimCadena[Cadena] = "Walmart",
			        fInventarioCadena[Fecha] = _f,
			        fInventarioCadena[Piezas_disponibles] > 0
			    )
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Promedio de piezas vendidas en los últimos 3 meses cerrados de cada cadena (propuesta; ver DEFINICIONES_INDICADORES.md).
	measure 'Venta promedio mensual piezas' =
			SUMX (
			    VALUES ( dimCadena[Cadena] ),
			    VAR _ultimo = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), REMOVEFILTERS ( dimProducto ), REMOVEFILTERS ( dimTienda ) )
			    VAR _fin = IF ( _ultimo = EOMONTH ( _ultimo, 0 ), _ultimo, EOMONTH ( _ultimo, -1 ) )
			    VAR _ini = EOMONTH ( _fin, -3 ) + 1
			    RETURN
			        IF ( ISBLANK ( _ultimo ), BLANK (), DIVIDE ( CALCULATE ( [Sell out piezas], DATESBETWEEN ( Calendario[Fecha], _ini, _fin ) ), 3 ) )
			)
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Meses de inventario: inventario / venta promedio mensual. Misma fórmula para las dos cadenas.
	measure 'Cobertura meses' = DIVIDE ( [Inventario piezas], [Venta promedio mensual piezas] )
		formatString: 0.0
		displayFolder: 2. Inventario en cadenas

	/// Umbrales provisionales: menos de 1 mes riesgo, de 1 a 3 saludable, más de 3 sobre stock. Pendientes de aprobar.
	measure 'Clasificación cobertura' =
			VAR _inv = [Inventario piezas]
			VAR _vta = [Venta promedio mensual piezas]
			VAR _cob = DIVIDE ( _inv, _vta )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _inv ) && ISBLANK ( _vta ), BLANK (),
			        _inv <= 0, "⚫ Sin inventario",
			        ISBLANK ( _vta ) || _vta <= 0, "⚪ Sin rotación",
			        _cob < 1, "🔴 Riesgo de quiebre",
			        _cob <= 3, "🟢 Saludable",
			        "🟡 Sobre stock"
			    )
		displayFolder: 2. Inventario en cadenas

	/// Productos con menos de 1 mes de cobertura. Se cuenta cada producto en cada cadena: si le pasa en Walmart y en Amazon, cuenta 2.
	measure 'Productos en riesgo de quiebre' =
			COUNTROWS (
			    FILTER (
			        CROSSJOIN ( VALUES ( dimProducto[Codigo_ERP] ), VALUES ( dimCadena[Cadena] ) ),
			        [Clasificación cobertura] = "🔴 Riesgo de quiebre"
			    )
			) + 0
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Productos con venta en los últimos 3 meses y 0 piezas en la última foto. Se cuenta cada producto en cada cadena: si le pasa en Walmart y en Amazon, cuenta 2.
	measure 'Productos sin inventario' =
			COUNTROWS (
			    FILTER (
			        CROSSJOIN ( VALUES ( dimProducto[Codigo_ERP] ), VALUES ( dimCadena[Cadena] ) ),
			        [Clasificación cobertura] = "⚫ Sin inventario"
			    )
			) + 0
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Productos con más de 3 meses de cobertura. Se cuenta cada producto en cada cadena: si le pasa en Walmart y en Amazon, cuenta 2.
	measure 'Productos con sobre stock' =
			COUNTROWS (
			    FILTER (
			        CROSSJOIN ( VALUES ( dimProducto[Codigo_ERP] ), VALUES ( dimCadena[Cadena] ) ),
			        [Clasificación cobertura] = "🟡 Sobre stock"
			    )
			) + 0
		formatString: #,0
		displayFolder: 2. Inventario en cadenas

	/// Vale 1 cuando una tienda de Walmart vendió el producto en los últimos 28 días y hoy tiene 0 piezas. Filtra la tabla de tiendas sin inventario.
	measure 'Alerta tienda sin inventario' = IF ( [Venta 28 días Walmart] > 0 && [Inventario piezas] + 0 <= 0, 1 )
		formatString: 0
		displayFolder: 2. Inventario en cadenas

	/// Piezas pedidas por Walmart en sus órdenes de compra.
	measure 'Piezas ordenadas' = SUM ( fFillRate[Piezas_ordenadas] )
		formatString: #,0
		displayFolder: 3. Fill rate

	/// Piezas que Walmart recibió de esas órdenes.
	measure 'Piezas recibidas' = SUM ( fFillRate[Piezas_recibidas] )
		formatString: #,0
		displayFolder: 3. Fill rate

	/// Piezas recibidas / piezas ordenadas, por mes de la fecha de la orden (propuesta).
	measure 'Fill rate' = DIVIDE ( [Piezas recibidas], [Piezas ordenadas] )
		formatString: 0.0%
		displayFolder: 3. Fill rate

	/// Piezas ordenadas que Walmart no recibió.
	measure 'Piezas no surtidas' = [Piezas ordenadas] - [Piezas recibidas]
		formatString: #,0
		displayFolder: 3. Fill rate

	/// Piezas que Walmart planea pedir (Recship más reciente).
	measure 'Pronóstico piezas' = SUM ( fRecship[Piezas] )
		formatString: #,0
		displayFolder: 4. Pronóstico

	/// Piezas planeadas por costo por pieza, en MXN.
	measure 'Pronóstico monto' = SUM ( fRecship[Monto] )
		formatString: "$"#,0
		displayFolder: 4. Pronóstico

	/// Meta mensual de sell in en MXN (hoja Metas del maestro).
	measure 'Meta monto' = SUM ( Metas[Monto] )
		formatString: "$"#,0
		displayFolder: 5. Metas

	/// Meta mensual de sell in en piezas.
	measure 'Meta piezas' = SUM ( Metas[Cantidad] )
		formatString: #,0
		displayFolder: 5. Metas

	/// Último día con sell out de Walmart.
	measure 'Datos al - sell out Walmart' = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), fSellOut[Cadena] = "Walmart", REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Último día que cubre el archivo de ventas de Amazon más reciente.
	measure 'Datos al - sell out Amazon' = CALCULATE ( MAX ( fSellOut[Datos_hasta] ), fSellOut[Cadena] = "Amazon", REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Fecha de la última foto de inventario de Walmart.
	measure 'Datos al - inventario Walmart' = CALCULATE ( MAX ( fInventarioCadena[Fecha] ), fInventarioCadena[Cadena] = "Walmart", REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Fecha de la última foto de inventario de Amazon.
	measure 'Datos al - inventario Amazon' = CALCULATE ( MAX ( fInventarioCadena[Fecha] ), fInventarioCadena[Cadena] = "Amazon", REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Fecha de la orden más reciente en el fill rate.
	measure 'Datos al - fill rate Walmart' = CALCULATE ( MAX ( fFillRate[Fecha_orden] ), REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Días entre el primero y el último con datos en los que no hay sell out de Walmart (descargas faltantes).
	measure 'Días sin sell out Walmart' =
			VAR _dias = CALCULATETABLE ( VALUES ( fSellOut[Fecha] ), fSellOut[Cadena] = "Walmart", REMOVEFILTERS () )
			VAR _ini = MINX ( _dias, fSellOut[Fecha] )
			VAR _fin = MAXX ( _dias, fSellOut[Fecha] )
			RETURN
			    IF ( ISBLANK ( _ini ), BLANK (), COUNTROWS ( EXCEPT ( CALENDAR ( _ini, _fin ), _dias ) ) + 0 )
		formatString: #,0
		displayFolder: 9. Control

	/// Días sin foto de inventario de Walmart entre la primera y la última.
	measure 'Días sin inventario Walmart' =
			VAR _dias = CALCULATETABLE ( VALUES ( fInventarioCadena[Fecha] ), fInventarioCadena[Cadena] = "Walmart", REMOVEFILTERS () )
			VAR _ini = MINX ( _dias, fInventarioCadena[Fecha] )
			VAR _fin = MAXX ( _dias, fInventarioCadena[Fecha] )
			RETURN
			    IF ( ISBLANK ( _ini ), BLANK (), COUNTROWS ( EXCEPT ( CALENDAR ( _ini, _fin ), _dias ) ) + 0 )
		formatString: #,0
		displayFolder: 9. Control

	/// Meses sin archivo de ventas de Amazon entre el primero y el último cargados.
	measure 'Meses sin sell out Amazon' =
			VAR _meses = CALCULATETABLE ( VALUES ( fSellOut[Fecha] ), fSellOut[Cadena] = "Amazon", REMOVEFILTERS () )
			VAR _ini = MINX ( _meses, fSellOut[Fecha] )
			VAR _fin = MAXX ( _meses, fSellOut[Fecha] )
			RETURN
			    IF ( ISBLANK ( _ini ), BLANK (), COUNTROWS ( EXCEPT ( FILTER ( CALENDAR ( _ini, _fin ), DAY ( [Date] ) = 1 ), _meses ) ) + 0 )
		formatString: #,0
		displayFolder: 9. Control

	/// Lista de los meses sin archivo de ventas de Amazon, para saber qué descargar.
	measure 'Meses faltantes Amazon' =
			VAR _meses = CALCULATETABLE ( VALUES ( fSellOut[Fecha] ), fSellOut[Cadena] = "Amazon", REMOVEFILTERS () )
			VAR _ini = MINX ( _meses, fSellOut[Fecha] )
			VAR _fin = MAXX ( _meses, fSellOut[Fecha] )
			VAR _faltan = EXCEPT ( FILTER ( CALENDAR ( _ini, _fin ), DAY ( [Date] ) = 1 ), _meses )
			VAR _lista = CONCATENATEX ( _faltan, LOOKUPVALUE ( Calendario[Mes_año], Calendario[Fecha], [Date] ), ", ", [Date], ASC )
			RETURN
			    IF ( ISBLANK ( _ini ), BLANK (), IF ( COUNTROWS ( _faltan ) = 0, "Ninguno", _lista ) )
		displayFolder: 9. Control

	/// Filas cuyo código de cadena no está en la hoja Equivalencias del maestro.
	measure 'Filas sin homologar' =
			CALCULATE ( COUNTROWS ( fSellOut ), REMOVEFILTERS (), ISBLANK ( fSellOut[Codigo_ERP] ) ) + 0
			    + CALCULATE ( COUNTROWS ( fInventarioCadena ), REMOVEFILTERS (), ISBLANK ( fInventarioCadena[Codigo_ERP] ) ) + 0
			    + CALCULATE ( COUNTROWS ( fFillRate ), REMOVEFILTERS (), ISBLANK ( fFillRate[Codigo_ERP] ) ) + 0
			    + CALCULATE ( COUNTROWS ( fRecship ), REMOVEFILTERS (), ISBLANK ( fRecship[Codigo_ERP] ) ) + 0
		formatString: #,0
		displayFolder: 9. Control

	/// Lista de códigos (artículo de Walmart o ASIN) que faltan en la hoja Equivalencias.
	measure 'Códigos sin homologar' =
			VAR _t =
			    UNION (
			        SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( fSellOut[Codigo_cadena] ), REMOVEFILTERS (), ISBLANK ( fSellOut[Codigo_ERP] ) ), "Codigo", fSellOut[Codigo_cadena] ),
			        SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( fInventarioCadena[Codigo_cadena] ), REMOVEFILTERS (), ISBLANK ( fInventarioCadena[Codigo_ERP] ) ), "Codigo", fInventarioCadena[Codigo_cadena] ),
			        SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( fFillRate[Codigo_cadena] ), REMOVEFILTERS (), ISBLANK ( fFillRate[Codigo_ERP] ) ), "Codigo", fFillRate[Codigo_cadena] ),
			        SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( fRecship[Codigo_cadena] ), REMOVEFILTERS (), ISBLANK ( fRecship[Codigo_ERP] ) ), "Codigo", fRecship[Codigo_cadena] )
			    )
			VAR _lista = CONCATENATEX ( DISTINCT ( _t ), [Codigo], ", " )
			RETURN
			    IF ( _lista = "", "Ninguno", _lista )
		displayFolder: 9. Control

	/// Encabezado de la página Sell out: último día con datos de cada cadena.
	measure 'Texto datos sell out' = "Sell out · Walmart al " & IF ( ISBLANK ( [Datos al - sell out Walmart] ), "sin datos", FORMAT ( [Datos al - sell out Walmart], "dd/mm/yyyy" ) ) & "  ·  Amazon al " & IF ( ISBLANK ( [Datos al - sell out Amazon] ), "sin datos", FORMAT ( [Datos al - sell out Amazon], "dd/mm/yyyy" ) )
		displayFolder: 9. Control

	/// Encabezado de la página Inventario: fecha de la última foto de cada cadena.
	measure 'Texto datos inventario' = "Inventario · Walmart al " & IF ( ISBLANK ( [Datos al - inventario Walmart] ), "sin datos", FORMAT ( [Datos al - inventario Walmart], "dd/mm/yyyy" ) ) & "  ·  Amazon al " & IF ( ISBLANK ( [Datos al - inventario Amazon] ), "sin datos", FORMAT ( [Datos al - inventario Amazon], "dd/mm/yyyy" ) )
		displayFolder: 9. Control

	/// Fecha en que Walmart generó el Recship más reciente.
	measure 'Fecha del Recship' = CALCULATE ( MAX ( fRecship[Fecha_creacion] ), REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 9. Control

	/// Encabezado de la página Abasto: orden más reciente del fill rate y fecha del Recship.
	measure 'Texto datos abasto' = "Walmart · órdenes hasta el " & IF ( ISBLANK ( [Datos al - fill rate Walmart] ), "sin datos", FORMAT ( [Datos al - fill rate Walmart], "dd/mm/yyyy" ) ) & "  ·  Recship del " & IF ( ISBLANK ( [Fecha del Recship] ), "sin datos", FORMAT ( [Fecha del Recship], "dd/mm/yyyy" ) )
		displayFolder: 9. Control

	/// Semáforo general con el motivo. Rojo: faltan días de Walmart, faltan meses de Amazon o hay códigos sin homologar. Amarillo: el sell out de Walmart o de Amazon tiene más de 3 días.
	measure 'Estado del reporte' =
			VAR _hoy = TODAY ()
			VAR _atrasoWM = IF ( ISBLANK ( [Datos al - sell out Walmart] ), 999, DATEDIFF ( [Datos al - sell out Walmart], _hoy, DAY ) )
			VAR _atrasoAMZ = IF ( ISBLANK ( [Datos al - sell out Amazon] ), 999, DATEDIFF ( [Datos al - sell out Amazon], _hoy, DAY ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        [Días sin sell out Walmart] > 0, "🔴 Faltan días de sell out de Walmart",
			        [Meses sin sell out Amazon] > 0, "🔴 Faltan meses de ventas de Amazon",
			        [Filas sin homologar] > 0, "🔴 Hay códigos sin homologar",
			        _atrasoWM > 3, "🟡 Sell out de Walmart atrasado",
			        _atrasoAMZ > 3, "🟡 Ventas de Amazon atrasadas",
			        "🟢 Listo para enviar"
			    )
		displayFolder: 9. Control

	column Columna
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Columna

	partition _Medidas = m
		mode: import
		source =
				#table(type table [Columna = text], {})

	annotation PBI_ResultType = Table
